# 根级环境变量样例，复制为 .env 后按需修改

# 后端
# 公开部署时改为 sqlite:////app/data/app.db（docker 卷）或你的 PostgreSQL/SeekDB 地址
DATABASE_URL=sqlite:////app/data/app.db
# 生产务必换成随机长字符串
JWT_SECRET=dev-secret-change-me-in-prod
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAY=7
# 公开部署（前端与后端不同域名）时改为 * 或具体前端域名列表
CORS_ORIGINS=*
ENVIRONMENT=dev

# 前端构建时注入（本地开发默认即可；公开部署推荐改 dist/config.js 而不是重建）
VITE_API_BASE=/api